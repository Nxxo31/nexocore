// NexoCore — Prisma Schema
// Multi-tenant SaaS ERP/CRM/Analytics
// Patrón: Hybrid Pool/Silo (MVP = Pool con tenant_id + RLS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Industry {
  FERRETERIA
  RESTAURANTE
  CONSULTORA
  RETAIL
  CLINICA
  PAPELERIA
  CARNICERIA
}

enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  VIEWER
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

enum POStatus {
  DRAFT
  SENT
  RECEIVED
  PARTIAL
  CANCELLED
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceType {
  INVOICE
  QUOTE
  CREDIT_NOTE
  RECEIPT
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  NEQUI
  DAVIPLATA
}

enum Period {
  DAILY
  WEEKLY
  MONTHLY
}

enum AlertType {
  STOCK_LOW
  INVOICE_OVERDUE
  DEAL_STALE
  KPI_ANOMALY
  ORDER_DELAYED
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

enum SubStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
}

// ============================================================================
// NÚCLEO MULTI-TENANT
// ============================================================================

model Workspace {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  industry        Industry
  templateId      String
  templateConfig  Json     @default("{}")
  plan            Plan     @default(STARTER)
  currency        String   @default("COP")
  timezone        String   @default("America/Bogota")
  logoUrl         String?
  customDomain    String?  @unique
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           WorkspaceUser[]
  products        Product[]
  suppliers       Supplier[]
  purchaseOrders  PurchaseOrder[]
  contacts        Contact[]
  deals           Deal[]
  invoices        Invoice[]
  payments        Payment[]
  movements       InventoryMovement[]
  kpiSnapshots    KpiSnapshot[]
  alerts          Alert[]
  subscription    Subscription?
}

model WorkspaceUser {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        Role      @default(VIEWER)
  invitedAt   DateTime? 
  joinedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  avatarUrl     String?
  passwordHash  String?
  emailVerified DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  workspaces    WorkspaceUser[]
  accounts      Account[]
  sessions      Session[]
}

// NextAuth v5 models

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// MÓDULO ERP — INVENTARIO
// ============================================================================

model Product {
  id              String    @id @default(cuid())
  tenantId        String
  sku             String
  name            String
  description     String?
  category        String    
  unit            String    @default("und")
  salePrice       Decimal   @default(0) @db.Decimal(12, 2)
  costPrice       Decimal   @default(0) @db.Decimal(12, 2)
  currentStock    Decimal   @default(0) @db.Decimal(12, 2)
  minStock        Decimal   @default(0) @db.Decimal(12, 2)
  maxStock        Decimal?  @db.Decimal(12, 2)
  supplierId      String?
  imageUrl        String?
  isActive        Boolean   @default(true)
  customFields    Json      @default("{}")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace       Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  movements       InventoryMovement[]
  invoiceItems    InvoiceItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, category])
  @@index([tenantId, isActive])
}

model InventoryMovement {
  id            String        @id @default(cuid())
  tenantId      String
  productId     String
  type          MovementType
  quantity      Decimal       @db.Decimal(12, 2)
  previousStock Decimal       @db.Decimal(12, 2)
  newStock      Decimal       @db.Decimal(12, 2)
  unitCost      Decimal?      @db.Decimal(12, 2)
  reason        String?
  reference     String?
  userId        String?
  createdAt     DateTime      @default(now())

  workspace     Workspace     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
}

model Supplier {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  contact     String?
  email       String?
  phone       String?
  address     String?
  nit         String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  workspace   Workspace  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  tenantId    String
  supplierId  String
  status      POStatus  @default(DRAFT)
  items       Json      @default("[]")
  subtotal    Decimal   @default(0) @db.Decimal(12, 2)
  tax         Decimal   @default(0) @db.Decimal(12, 2)
  total       Decimal   @default(0) @db.Decimal(12, 2)
  dueDate     DateTime?
  receivedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// ============================================================================
// MÓDULO CRM
// ============================================================================

model Contact {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  email         String?
  phone         String?
  company       String?
  documentType  String?
  document      String?
  address       String?
  tags          String[]  @default([])
  stage         String?
  assignedTo    String?
  customFields  Json      @default("{}")
  isActive      Boolean   @default(true)
  lastContactAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace     Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals         Deal[]
  activities    Activity[]
  invoices      Invoice[]

  @@index([tenantId])
  @@index([tenantId, stage])
}

model Deal {
  id              String    @id @default(cuid())
  tenantId        String
  contactId       String
  title           String
  value           Decimal   @default(0) @db.Decimal(12, 2)
  stage           String    @default("lead")
  probability     Int       @default(0)
  expectedCloseAt DateTime?
  closedAt        DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  lostReason      String?
  assignedTo      String?
  customFields    Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace       Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  activities      Activity[]
  invoices        Invoice[]

  @@index([tenantId, stage])
  @@index([tenantId, contactId])
}

model Activity {
  id            String        @id @default(cuid())
  tenantId      String
  contactId     String?
  dealId        String?
  type          ActivityType
  title         String
  description   String?
  scheduledAt   DateTime?
  completedAt   DateTime?
  userId        String?
  createdAt     DateTime      @default(now())

  workspace     Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact       Contact?  @relation(fields: [contactId], references: [id])
  deal          Deal?     @relation(fields: [dealId], references: [id])

  @@index([tenantId, scheduledAt])
}

// ============================================================================
// MÓDULO FACTURACIÓN
// ============================================================================

model Invoice {
  id              String        @id @default(cuid())
  tenantId        String
  number          String
  contactId       String?
  dealId          String?
  status          InvoiceStatus @default(DRAFT)
  type            InvoiceType   @default(INVOICE)
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  paidAt          DateTime?
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  taxRate         Decimal       @default(19) @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  notes           String?
  termsConditions String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace       Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact         Contact?  @relation(fields: [contactId], references: [id])
  deal            Deal?     @relation(fields: [dealId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, issueDate])
}

model InvoiceItem {
  id          String    @id @default(cuid())
  tenantId    String
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal   @db.Decimal(12, 2)
  unitPrice   Decimal   @db.Decimal(12, 2)
  discount    Decimal   @default(0) @db.Decimal(12, 2)
  taxRate     Decimal   @default(19) @db.Decimal(5, 2)
  total       Decimal   @db.Decimal(12, 2)

  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  invoiceId   String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod @default(CASH)
  reference   String?
  paidAt      DateTime      @default(now())
  createdAt   DateTime      @default(now())

  workspace   Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, paidAt])
}

// ============================================================================
// MÓDULO ANALYTICS
// ============================================================================

model KpiSnapshot {
  id          String    @id @default(cuid())
  tenantId    String
  period      Period
  periodKey   String    // '2026-08' | '2026-W32' | '2026-08-07'
  metric      String    // 'total_sales' | 'gross_margin' | etc.
  value       Decimal   @db.Decimal(14, 4)
  target      Decimal?  @db.Decimal(14, 4)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodKey, metric])
  @@index([tenantId, metric])
}

model Alert {
  id          String      @id @default(cuid())
  tenantId    String
  type        AlertType
  severity    Severity    @default(INFO)
  title       String
  body        String
  isRead      Boolean     @default(false)
  isDismissed Boolean     @default(false)
  relatedId   String?
  relatedType String?
  createdAt   DateTime    @default(now())

  workspace   Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isRead])
  @@index([tenantId, type])
}

// ============================================================================
// MÓDULO BILLING (Stripe — Sprint 4)
// ============================================================================

model Subscription {
  id                String    @id @default(cuid())
  workspaceId       String    @unique
  stripeCustomerId  String
  stripePriceId     String
  plan              Plan
  status            SubStatus @default(TRIALING)
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
