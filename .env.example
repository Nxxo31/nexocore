# NexoCore Environment Variables
# Copy to .env.local and fill in your values

# Database (PostgreSQL — local or Neon/Railway)
DATABASE_URL="postgresql://nexocore:nexocore@localhost:5432/nexocore?schema=public"

# NextAuth v5
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (Sprint 4)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""

# Redis / BullMQ (Sprint 2-4)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# Email / Resend (Sprint 3)
RESEND_API_KEY=""
EMAIL_FROM="noreply@nexocore.co"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="nexocore.co"
